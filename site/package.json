{
  "name": "template-github-actions-cicd",
  "description": "Template repo for my GitHub Actions CI/CD blog post - builds, tests, and deploys a simple website via GitHub Actions.",
  "version": "0.0.0",
  "author": "Adam Harvey",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "prepare": "husky",
    "release": "commit-and-tag-version"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "commit-and-tag-version": "^12.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "vite": "^7.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
